{
  "name": "higoverse-desktop",
  "productName": "Higoverse",
  "version": "1.7.2",
  "description": "Higoverse for Windows: business records, sales and stock.",
  "author": "Higoverse <higoverse@gmail.com>",
  "homepage": "https://higoverse.com",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.higoverse.desktop",
    "productName": "Higoverse",
    "copyright": "Copyright © 2026 Higoverse",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "loading.html",
      "window-state.js",
      "shell-text.js",
      "updates.js",
      "updater.html",
      "updater-preload.js",
      "update-core.js",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "Higoverse"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Higoverse",
      "uninstallDisplayName": "Higoverse",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Higoverse-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://higoverse.com/downloads/desktop/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
